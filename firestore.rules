rules_version = '2';

// Shared data for builds with VITE_SHARED=on (park-kenneth.web.app), see src/lib/shared.ts.
// Deploy with: npm run deploy:park-data. Anything not matched below can be neither read nor written.
service cloud.firestore {
  match /databases/{database}/documents {

    // "Kondisi di lokasi beda?" Anyone may add a report and read recent ones; nobody may change or
    // delete one. A report holds the place, what the driver saw and the server's clock, nothing about
    // who sent it.
    match /reports/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow create: if request.resource.data.keys().hasOnly(['venueId', 'kind', 'at'])
        && request.resource.data.venueId is string
        && request.resource.data.venueId.matches('[a-z0-9-]{2,40}')
        && request.resource.data.kind in ['penuh', 'antri', 'lega']
        && request.resource.data.at == request.time;
    }

    // Drivers' yes/no ratings of a car park. Like reports: anyone may add one and read recent ones,
    // nobody may change or delete one, and a rating says nothing about who sent it.
    match /reviews/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 2000;
      allow create: if request.resource.data.keys().hasOnly(['venueId', 'aspect', 'good', 'at'])
        && request.resource.data.venueId is string
        && request.resource.data.venueId.matches('[a-z0-9-]{2,40}')
        && request.resource.data.aspect in ['light', 'wide', 'safe', 'signal']
        && request.resource.data.good is bool
        && request.resource.data.at == request.time;
    }

    // Merchant offers from /mitra. Everyone reads them, since they show on the place page. Only a
    // signed-in Google account can publish one, in its own name, with short plain fields; nobody can
    // change one, and only the account that published it can take it down.
    match /promos/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 500;
      allow create: if request.auth != null && isPromo(request.resource.data, id);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Booth answers (/booth), pooled per booth session. The session key in the path is the only way
    // in: no rule lists sessions, so only a phone that scanned the session's code can read or add.
    // Answers carry no contact details; those stay on the phone they were typed on. An answer can be
    // sent again after a dropped connection, but never changed or deleted from a phone.
    match /booths/{session}/answers/{id} {
      allow read: if isSession(session);
      allow create: if isSession(session) && isAnswer(request.resource.data, id);
      allow update: if isSession(session) && request.resource.data == resource.data;
    }

    function isSession(key) {
      return key.matches('[A-Za-z0-9_-]{22}');
    }

    function isLine(v, max) {
      return v is string && v.size() <= max;
    }

    function isPromo(d, id) {
      return d.keys().hasOnly(['venueId', 'merchant', 'kind', 'title', 'floor', 'days', 'from', 'to', 'parking', 'busy', 'owner', 'at'])
        && id.matches('m-[0-9]{10,16}')
        && d.owner == request.auth.uid
        && d.at == request.time
        && d.venueId is string && d.venueId.matches('[a-z0-9-]{2,40}')
        && d.kind in ['promo', 'event']
        && isLine(d.merchant, 40) && d.merchant.size() > 0
        && isLine(d.title, 80) && d.title.size() > 0
        && isLine(d.floor, 20)
        && isLine(d.parking, 80)
        && d.days is list && d.days.size() > 0 && d.days.size() <= 7 && d.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && d.from is int && d.to is int && d.from >= 0 && d.to <= 24 && d.from < d.to
        && d.busy is bool;
    }

    function isText(v) {
      return v is string && v.size() <= 1000;
    }

    function isAnswer(d, id) {
      return d.keys().hasOnly(['id', 'at', 'lastTime', 'lostMin', 'tolerance', 'features', 'payPriority', 'like', 'wish', 'question', 'idea'])
        && d.id == id
        && id.matches('[A-Za-z0-9-]{1,40}')
        && d.at is int
        && d.lastTime in ['minggu', 'bulan', 'lama', 'tidak']
        && d.lostMin in ['<5', '5-15', '15-30', '>30', '']
        && d.tolerance in ['ya', 'mungkin', 'tidak']
        && d.features is list
        && d.features.size() <= 2
        && d.features.hasOnly(['okupansi', 'alternatif', 'gerbang', 'ingetin', 'biaya', 'mobil', 'difabel', 'prioritas', 'ev'])
        && d.payPriority in ['ya', 'tergantung', 'tidak']
        && isText(d.like)
        && isText(d.wish)
        && isText(d.question)
        && isText(d.idea);
    }
  }
}
