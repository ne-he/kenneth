# Google sign-in (optional). Without these the app runs in guest mode only.
# Get the values with: npx firebase-tools apps:sdkconfig WEB --project kenneth-9339d
# then copy this file to .env.local and fill it in. There is no auth domain to set:
# src/lib/auth.ts always uses <project id>.firebaseapp.com, the only sign-in handler
# Google accepts for this project. VITE_FIREBASE_AUTH_DOMAIN is ignored if present.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=kenneth-9339d
VITE_FIREBASE_APP_ID=

# park-kenneth.web.app (npm run deploy:park) builds in mode "park", which also reads .env.park.local.
# Put the same three keys there with the park-kenneth values:
#   npx firebase-tools apps:sdkconfig WEB --project park-kenneth
# and VITE_SHARED=on to share condition reports and booth sessions through that project's Firestore
# (src/lib/shared.ts). Without it every report and booth answer stays on the phone.
